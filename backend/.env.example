FLASK_APP=app.py
FLASK_DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRY_HOURS=12
RESET_TOKEN_EXPIRY_MINUTES=30

# Optional. If omitted or still set to a PostgreSQL URL, the app uses
# backend/instance/brightloop.db (path is resolved from this project, not the cwd).
DATABASE_URL=sqlite:///instance/brightloop.db

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional SMTP. If omitted, reset links are printed in the Flask console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@brightloop.local
SMTP_USE_TLS=true
