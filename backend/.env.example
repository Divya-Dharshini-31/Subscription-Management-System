FLASK_APP=app.py
FLASK_DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRY_HOURS=12
RESET_TOKEN_EXPIRY_MINUTES=30

# Optional. If omitted or still set to a PostgreSQL URL, the app uses
# backend/instance/brightloop.db (path is resolved from this project, not the cwd).
DATABASE_URL=sqlite:///instance/brightloop.db

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Email configuration for password reset.
# For Gmail SMTP:
# 1. Enable 2FA on your Google Account
# 2. Generate App Password: https://support.google.com/accounts/answer/185833
# 3. Use 16-character App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true

# Alternative for development/testing without real email:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@brightloop.local
# SMTP_USE_TLS=true
